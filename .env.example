# ==========================================
# VERCEL ENVIRONMENT VARIABLES
# Add these in Vercel -> Project Settings -> Environment Variables
# ==========================================

# 1. GitHub Personal Access Token (PAT)
# Needs 'repo' and 'workflow' scopes
GITHUB_PAT=ghp_...

# 2. LinkedIn Developer App Credentials
LINKEDIN_CLIENT_ID=your_client_id_here
LINKEDIN_CLIENT_SECRET=your_client_secret_here

# ==========================================
# OPTIONAL (Auto-detected by Vercel)
# You ONLY need these if Vercel doesn't automatically detect your GitHub repo
# ==========================================
GITHUB_REPO_OWNER=your_github_username
GITHUB_REPO_NAME=linkedin-quote-automation
NEXT_PUBLIC_SITE_URL=https://your-vercel-project.vercel.app

# ==========================================
# GITHUB SECRETS (Do NOT put in Vercel!)
# Add this in GitHub -> Repo Settings -> Secrets and variables -> Actions
# ==========================================
# GEMINI_API_KEY=your_google_gemini_api_key
