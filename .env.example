# 1. Anthropic API Key (for Claude 3.5 Sonnet quote generation)
# Get from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-api03-...

# 2. LinkedIn Access Token (OAuth 2.0 with w_member_social or w_organization_social scope)
LINKEDIN_ACCESS_TOKEN=AQV...

# 3. LinkedIn Author URN
# For Personal Profile: urn:li:person:YOUR_MEMBER_ID
# For Company / Organization Page: urn:li:organization:YOUR_ORGANIZATION_ID
LINKEDIN_AUTHOR_URN=urn:li:organization:12345678
